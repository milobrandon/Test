# ============================================
# Synthflow Calendar Booking - Configuration
# ============================================
# Copy this file to .env and fill in your values

# --- Server ---
PORT=3000
APP_URL=http://localhost:3000

# --- Synthflow ---
SYNTHFLOW_API_KEY=your_synthflow_api_key
SYNTHFLOW_WEBHOOK_SECRET=your_webhook_secret

# --- Google Calendar ---
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# --- Microsoft Outlook ---
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_REDIRECT_URI=http://localhost:3000/auth/microsoft/callback
MICROSOFT_TENANT_ID=common

# --- CalDAV (Apple Calendar / iCloud / FastMail / etc.) ---
CALDAV_SERVER_URL=https://caldav.icloud.com
CALDAV_USERNAME=your_apple_id
CALDAV_PASSWORD=your_app_specific_password

# --- Service Platforms (Future) ---
# SERVICETITAN_APP_KEY=
# SERVICETITAN_TENANT_ID=
# HOUSECALLPRO_API_KEY=
# JOBBER_CLIENT_ID=
# JOBBER_CLIENT_SECRET=
